{
  "name": "cws-next-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node security-scan.js && next build",
    "start": "next start",
    "lint": "eslint",
    "prepare": "husky",
    "db:init": "tsx --env-file=.env scripts/db-init.ts",
    "db:seed": "tsx --env-file=.env scripts/db-seed.ts",
    "db:migrate:sections": "tsx --env-file=.env scripts/migrate-sections.ts",
    "db:migrate:account-security": "tsx --env-file=.env scripts/migrate-account-security.ts",
    "db:migrate:catalog-scenes": "tsx --env-file=.env scripts/migrate-catalog-scenes.ts",
    "db:migrate:alt-text": "tsx --env-file=.env scripts/migrate-product-alt-text.ts",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "docs:generate": "tsx scripts/generate-openapi.ts",
    "docs:lint": "redocly lint .openapi/openapi.json",
    "docs:coverage": "npx tsx scripts/check-route-coverage.ts",
    "docs:check": "npx tsx scripts/docs-check.ts",
    "test:api-contract": "npx tsx scripts/check-contract.ts",
    "docs:dev": "pnpm docs:generate && next dev",
    "docs:watch": "nodemon --watch src --ext ts --exec \"pnpm docs:generate\""
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@napi-rs/canvas": "^1.0.3",
    "@next/third-parties": "16.2.7",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "@zxcvbn-ts/core": "^4.1.2",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "argon2": "^0.44.0",
    "cloudinary": "^2.10.0",
    "jose": "^6.2.3",
    "lucide-react": "^0.546.0",
    "mongodb": "^6.16.0",
    "motion": "^12.23.24",
    "next": "16.2.7",
    "nodemailer": "^6.9.16",
    "otplib": "^13.4.1",
    "pdfjs-dist": "^6.2.108",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "sanitize-html": "^2.17.6",
    "zod": "^4.4.3",
    "zod-openapi": "^5.4.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@next/bundle-analyzer": "^16.2.12",
    "@playwright/test": "^1.49.0",
    "@redocly/cli": "^2.39.0",
    "@scalar/nextjs-api-reference": "^0.11.11",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.17",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "cross-env": "^10.1.0",
    "dotenv": "^16.4.5",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "husky": "^9.1.7",
    "nodemon": "^3.1.14",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "onlyBuiltDependencies": [
    "esbuild",
    "argon2"
  ]
}
