{
  "name": "cws-next-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node security-scan.js && next build",
    "start": "next start",
    "lint": "eslint",
    "prepare": "husky",
    "db:init": "tsx --env-file=.env scripts/db-init.ts",
    "db:seed": "tsx --env-file=.env scripts/db-seed.ts",
    "db:update-admin-email": "tsx --env-file=.env scripts/update-admin-email.ts",
    "db:migrate:sections": "tsx --env-file=.env scripts/migrate-sections.ts",
    "db:migrate:account-security": "tsx --env-file=.env scripts/migrate-account-security.ts",
    "db:migrate:catalog-scenes": "tsx --env-file=.env scripts/migrate-catalog-scenes.ts",
    "db:migrate:alt-text": "tsx --env-file=.env scripts/migrate-product-alt-text.ts",
    "db:migrate:to-new-uri": "tsx --env-file=.env scripts/migrate-db-to-new-uri.ts",
    "migrate:full-service": "tsx --env-file=.env scripts/migrate-full-service.ts",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "docs:generate": "tsx scripts/generate-openapi.ts",
    "docs:lint": "redocly lint .openapi/openapi.json",
    "docs:coverage": "npx tsx scripts/check-route-coverage.ts",
    "docs:check": "npx tsx scripts/docs-check.ts",
    "test:api-contract": "npx tsx scripts/check-contract.ts",
    "docs:dev": "pnpm docs:generate && next dev",
    "docs:watch": "nodemon --watch src --ext ts --exec \"pnpm docs:generate\""
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "@napi-rs/canvas": "^1.0.8",
    "@next/third-parties": "16.3.3",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "argon2": "^0.44.0",
    "bson": "^6.10.4",
    "cloudinary": "^2.11.0",
    "jose": "^6.2.10",
    "lucide-react": "^0.546.0",
    "mongodb": "^6.21.0",
    "motion": "^12.43.0",
    "next": "16.3.3",
    "nodemailer": "^9.0.6",
    "otplib": "^13.5.0",
    "pdfjs-dist": "^6.2.108",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "sanitize-html": "^2.17.7",
    "zod": "^4.5.2",
    "zod-openapi": "^5.4.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@netlify/functions": "^5.3.0",
    "@next/bundle-analyzer": "^16.3.3",
    "@playwright/test": "^1.62.1",
    "@redocly/cli": "^2.49.0",
    "@scalar/nextjs-api-reference": "^0.11.17",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^6.4.24",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/sanitize-html": "^2.16.1",
    "cross-env": "^10.1.0",
    "dotenv": "^16.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.3",
    "husky": "^9.1.7",
    "nodemon": "^3.1.14",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "onlyBuiltDependencies": [
    "esbuild",
    "argon2"
  ],
  "overrides": {
    "brace-expansion": ">=1.1.18",
    "nanoid": ">=3.3.18",
    "postcss": ">=8.5.23",
    "ip-address": ">=10.3.1",
    "protobufjs": ">=7.6.5",
    "sharp": ">=0.35.0"
  }
}