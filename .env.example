# =============================================================================
# CWS Next App — Environment Variables (.env.example)
# -----------------------------------------------------------------------------
# ⚠️  NEVER COMMIT A REAL SECRET. This file contains NON-SECRET DEV PLACEHOLDERS
#     only so the app boots locally with `pnpm dev`. The real file `.env` is
#     gitignored and MUST stay out of version control.
#
# SECRET-MANAGER POLICY (ALL non-local environments — staging, preview, prod):
#   The following variables MUST be sourced from a secret manager / platform env
#   and NEVER committed or pasted into a checked-in file:
#     • MONGODB_URI          (contains Atlas DB username + password)
#     • SESSION_SECRET       (signs session cookies — forgery risk if leaked)
#     • ARGON2_SECRET        (password-hash pepper — DB-leak protection)
#     • GOOGLE_CLIENT_SECRET (OAuth client secret)
#     • EMAIL_PASSWORD       (Gmail app password)
#     • ADMIN_SEED_PASSWORD  (initial admin account password)
#   Use your platform's secret store (Vercel/Netlify project env, HashiCorp
#   Vault, AWS Secrets Manager, etc.). The build/deploy pipeline reads these
#   from the platform env — they are NOT read from this file in those envs.
#   See README → "Deployment & Secrets Management" for injection instructions.
#
#   EXPLICIT PER-SECRET REQUIREMENT (applies to each of the 6 vars above):
#     MONGODB_URI, SESSION_SECRET, ARGON2_SECRET, GOOGLE_CLIENT_SECRET,
#     EMAIL_PASSWORD, and ADMIN_SEED_PASSWORD MUST be sourced from a secret
#     manager (Vercel/Netlify project env, HashiCorp Vault, AWS Secrets Manager)
#     in ALL non-local environments. NEVER commit a real value. The placeholders
#     below (and in .env) are dev-only; a real deployment injects unique values.
#
# ROTATION REQUIRED BEFORE ANY REAL DEPLOYMENT:
#   • The default SESSION_SECRET in this example (and the previously-shipped
#     static value) are BLOCKLISTED in src/auth/config/env.ts — the app refuses
#     to boot in production with them. Generate a UNIQUE one per environment:
#         openssl rand -hex 32
#   • ROTATE the MongoDB Atlas database credential (DB user/password). The
#     previously-used static DB password must NOT ship to a real environment.
# =============================================================================

# Database Configuration
# MONGODB_URI is a SECRET — it embeds the Atlas DB username + password.
# In any non-local environment it MUST come from the secret manager / platform
# env (Vercel/Netlify env, Vault, AWS Secrets Manager). Never commit a real
# Atlas connection string. In local dev the localhost placeholder below is fine.
# ROTATE the shipped DB credential before any real deployment.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=cws_auth

# Authentication Configuration
# Generate a UNIQUE value per environment with: openssl rand -hex 32
# Must be at least 32 characters long. NEVER reuse the dev/default value in
# production — a leaked SESSION_SECRET lets an attacker forge the HMAC-signed
# cws_session / cws_2fa_pending / cws_pw_pending cookies.
# The app refuses to boot in production if this is missing, <32 chars, or equal
# to a known default.
SESSION_SECRET=default_session_secret_must_be_thirty_two_characters_long
APP_URL=http://localhost:3000

# Cookie `Secure` flag — explicit, fail-closed control (Item 14).
# When 'true', ALL auth cookies (cws_session, cws_refresh, cws_device_token,
# cws_2fa_pending, cws_pw_pending, cws_stepup_pending, cws_oauth_state) are marked
# Secure (HTTPS-only). When 'false', they may be sent over plain HTTP (local dev).
# MUST be 'true' in production — src/auth/config/env.ts REFUSES TO BOOT if it is
# unset or 'false' while NODE_ENV=production (prevents cleartext cookie leaks from
# a misconfigured proxy or a non-prod alias reporting NODE_ENV=production).
# In local dev it is optional and defaults to false (so cookies work over HTTP).
# Set via the secret manager / platform env in ALL non-local environments.
# SECURE_COOKIES=true

# Trusted-proxy IP header (REQUIRED in production, optional in dev).
# When set, client IP resolution (login rate limiting + geo alerts) prefers this
# platform-supplied header (e.g. Vercel's 'x-vercel-proxied-for') over
# client-supplied x-forwarded-for, which is fully spoofable.
# IMPORTANT: also configure the edge to STRIP inbound x-forwarded-for before
# appending its own hop; otherwise an attacker can still inject a trusted-looking
# header name.
# The app REFUSES TO BOOT in production if this is unset: without it, client IP
# resolves to an untrusted '0.0.0.0' sentinel for all traffic, collapsing the
# per-IP login rate limit into a single global bucket (platform-wide lockout DoS).
# In dev it is warn-only and client IP falls back to x-forwarded-for.
# TRUSTED_PROXY_IP_HEADER=x-vercel-proxied-for

# Session / token lifetimes (optional; sensible defaults applied)
# ACCESS_SESSION_TTL_MS=900000        # 15 min — short-lived access session
# IDLE_TIMEOUT_MS=1800000             # 30 min — inactivity logout
# REFRESH_TOKEN_TTL_MS=604800000      # 7 days — refresh token lifetime

# WebAuthn / passkeys (optional overrides; defaults derive from APP_URL).
# In production the effective origin must be HTTPS, and the RP ID must match the
# origin host or a parent domain. Use WEBAUTHN_RP_ID when the app runs on a
# subdomain but passkeys should be scoped to the parent domain.
# WEBAUTHN_RP_ID=example.com
# WEBAUTHN_ORIGIN=https://admin.example.com

# Mobile API (Ed25519/EdDSA JWTs). Keep private key material in the deployment
# secret manager; values below are illustrative and intentionally commented out.
# MOBILE_ACCESS_TOKEN_TTL_MS=900000
# MOBILE_REFRESH_TOKEN_TTL_MS=604800000
# MOBILE_JWT_KEY_ID=mobile-2026-01
# MOBILE_JWT_PRIVATE_KEY_B64=<base64-encoded-PKCS8-Ed25519-private-key>
# MOBILE_JWT_PUBLIC_KEYS_JSON={"mobile-2026-01":"<base64-encoded-SPKI-Ed25519-public-key>"}
# MOBILE_JWT_ISSUER=https://app.example.com/api/mobile/v1
# MOBILE_GOOGLE_CLIENT_IDS=ios-client-id.apps.googleusercontent.com,android-client-id.apps.googleusercontent.com
# MOBILE_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# Step-up MFA + geo-IP (Item 9) — ON by default (opt-out, not opt-in).
# Step-up 2FA: when active (default), a login from a NEW device or a resolvable
# COUNTRY CHANGE requires email 2FA (reusing the existing verify-2fa flow) before
# the session is usable. Unset (the default) means step-up IS enabled. Override to
# 'false' (or '0') ONLY to deliberately relax step-up in an emergency/debugging —
# src/auth/config/env.ts warns loudly (never throws) when you do so in production.
# NOTE: country-change step-up only fires when GEOIP_LOOKUP_URL is configured (geo
# lookup is fail-open, so a null country is never treated as a change). Without a
# geo source, only NEW-DEVICE logins are challenged.
# STEP_UP_ENABLED=false
#
# Geo-IP lookup source (optional). When set, coarseLocation queries this endpoint
# (GET; the IP is passed as `?ip=<ip>` unless the URL contains a `{ip}` placeholder)
# with a 300ms timeout and fails open to null on any failure. If unset, an offline
# DB (`geoip-lite`, when installed) is tried; otherwise geo resolves to null.
# Example: GEOIP_LOOKUP_URL=https://geo.internal/lookup?ip=
# Example: GEOIP_LOOKUP_URL=https://geo.internal/lookup/{ip}

# Password Hash Pepper (REQUIRED in production, minimum 16 characters).
# Argon2id uses this as an application-side secret (argon2 "secret"/pepper) so a
# raw DB leak of the password hashes does not expose them without this key.
# Generate a UNIQUE value per environment with: openssl rand -hex 32
# The app REFUSES TO BOOT in production if ARGON2_SECRET is missing or shorter
# than 16 characters (same fail-closed pattern as SESSION_SECRET). Supply it via
# the secret manager / platform env (Vercel/Netlify env, Vault, AWS Secrets
# Manager) — never commit a real value. In dev (NODE_ENV !== 'production') the
# absence is only a warning and boot still succeeds without it.
# MIGRATION CAVEAT: enabling the pepper AFTER users already exist requires
# re-hashing every existing password (e.g. force a password reset / re-hash pass),
# because previously stored hashes were computed WITHOUT this pepper and will no
# longer verify (verifyPassword will return false for valid credentials).
ARGON2_SECRET=argon2_secret_pepper_min_16_characters

# Google OAuth (Authorization Code + PKCE) — optional
# When unset, the "Continue with Google" button yields a 503.
# GOOGLE_CLIENT_SECRET is a SECRET — in any non-local environment it MUST be
# sourced from the secret manager / platform env (Vercel/Netlify env, Vault,
# AWS Secrets Manager). Never commit a real OAuth client secret.
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Email delivery (Nodemailer + Gmail SMTP) — used for 2FA codes + password reset links
# No phone/SMS is used — all out-of-band challenges are email-based.
# When EMAIL_USER/EMAIL_PASSWORD/EMAIL_FROM are unset, emails are logged to the
# server console (dev) instead of sent. EMAIL_PASSWORD must be a Gmail "App
# Password" (16 chars), not the account password. Generate one at:
#   Google Account → Security → 2-Step Verification → App passwords
# EMAIL_PASSWORD is a SECRET — in any non-local environment it MUST come from the
# secret manager / platform env (Vercel/Netlify env, Vault, AWS Secrets Manager).
# Never commit a real Gmail app password.
EMAIL_FROM=no-reply@crossweavesourcing.com
EMAIL_USER=no-reply@crossweavesourcing.com
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx

# Predefined Admin User Seed Credentials (Optional, used during db:seed)
# ADMIN_SEED_PASSWORD is a SECRET — in any non-local environment it MUST be
# sourced from the secret manager / platform env (Vercel/Netlify env, Vault,
# AWS Secrets Manager), NOT from this file. The placeholder below is a
# NON-SECRET dev value for local boot only; ROTATE it before any real
# deployment and ensure the seeded admin password is changed on first login.
ADMIN_SEED_EMAIL=admin@crossweavesourcing.com
ADMIN_SEED_PASSWORD=SeedPassword123!
ADMIN_SEED_FIRST_NAME=System
ADMIN_SEED_LAST_NAME=Admin
ADMIN_SEED_EMPLOYEE_ID=EMP-0001
ADMIN_SEED_DEPARTMENT=Operations

# API Documentation Visibility
# When set to 'private', the OpenAPI JSON and interactive documentation UI
# return 404 in production (NODE_ENV=production). In development, docs are
# always available regardless of this setting. Defaults to public if unset.
# Set via the secret manager / platform env if you want to hide API docs in prod.
# DOCS_VISIBILITY=private

# Cloudinary Configuration for Image Uploads
# The secret is required for secure server-side uploads.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Google Tag Manager (GTM)
# Used for analytics and marketing tags. A placeholder GTM ID can be used for dev.
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Site Verification Tokens (Search Console / Webmaster Tools)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=

# PDF catalog processing limits (non-secret)
PDF_MAX_UPLOAD_MB=25
PDF_MAX_PAGES=100
PDF_MAX_SCENE_MB=12
PDF_PARSE_TIMEOUT_MS=55000
PDF_RENDER_DPI=200
